DATABASE_URL=postgres://postgres@localhost:5432/p2p
PORT=3000
# Maker fee in basis points (1 bps = 0.01%). PRD 10: rate is still to be decided.
MAKER_FEE_BPS=0
# 32 random bytes, base64. Generate with: openssl rand -base64 32
OTP_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
# New bank accounts can receive payments only after this many hours (fraud cooldown).
PAYMENT_METHOD_COOLDOWN_HOURS=24
# How often unpaid orders past their deadline are cancelled. 0 turns it off.
ORDER_EXPIRY_INTERVAL_SECONDS=30
