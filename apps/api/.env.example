DATABASE_URL=postgres://postgres@localhost:5432/p2p
PORT=3000
# 32 random bytes, base64. Generate with: openssl rand -base64 32
OTP_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
# New bank accounts can receive payments only after this many hours (fraud cooldown).
PAYMENT_METHOD_COOLDOWN_HOURS=24
# How often unpaid orders past their deadline are cancelled. 0 turns it off.
ORDER_EXPIRY_INTERVAL_SECONDS=30
# New withdrawal addresses can be used only after this many hours.
ADDRESS_COOLDOWN_HOURS=24
# Operations console session length.
OPS_SESSION_TTL_HOURS=8
# How often queued emails are sent. 0 turns it off.
EMAIL_INTERVAL_SECONDS=10
# Email through Resend (resend.com). Without RESEND_API_KEY, emails are written to the log instead of sent.
# EMAIL_FROM must use a domain verified in Resend, e.g. "P2P <no-reply@mail.example.com>".
# RESEND_API_KEY=
# EMAIL_FROM=
# Web app address used in emailed links (signup confirmation): <APP_URL>/signup/verify?token=...
APP_URL=http://localhost:3001
# Hours a signup confirmation link stays valid.
SIGNUP_LINK_TTL_HOURS=24
# How often fee invoices are issued and due dates checked. 0 turns it off.
BILLING_INTERVAL_SECONDS=300
# Sumsub identity verification. All four are needed; without them KYC reports itself as not set up.
# Point the Sumsub webhook at https://<api host>/kyc/sumsub/webhook.
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# SUMSUB_WEBHOOK_SECRET=
# SUMSUB_LEVEL_NAME=
# Hosted Postgres (e.g. Supabase): set to "require" to encrypt the connection.
# DATABASE_SSL=require
# Max database connections (default 20). Free hosted plans allow few.
# DATABASE_POOL_MAX=5
